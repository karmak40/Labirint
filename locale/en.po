msgstr "No fog of war"

msgid "Туман войны: снят"
msgstr "Fog of war: lifted"

msgid "Туман войны: есть"
msgstr "Fog of war: on"

msgid "Погоды нет"
msgstr "No weather"

msgid "Скоро: сумерки"
msgstr "Soon: dusk"

msgid "Скоро: ночь"
msgstr "Soon: night"

msgid "Скоро: рассвет"
msgstr "Soon: dawn"

msgid "Скоро: день"
msgstr "Soon: day"

msgid "Дождь: как по небу"
msgstr "Rain: as the sky wills"

msgid "Дождь: всегда"
msgstr "Rain: always"

msgid "Дождь: никогда"
msgstr "Rain: never"

msgid "Режим съёмки · F1 — клавиши · H — без подсказок · F10 — выход"
msgstr "Filming mode · F1 — keys · H — no hints · F10 — exit"

msgid "WASD / стрелки — камера (Shift — медленно),  C — дрейф"
msgstr "WASD / arrows — camera (Shift — slow),  C — drift"

msgid "колесо, Q / E — приближение"
msgstr "wheel, Q / E — zoom"

msgid "ЛКМ по бойцу — следить,  F — следить за выбранным / ближайшим"
msgstr "LMB on a fighter — follow,  F — follow the selected / nearest"

msgid "Ctrl+1..9 — запомнить кадр,  1..9 — перелёт,  Shift+1..9 — склейка"
msgstr "Ctrl+1..9 — save a shot,  1..9 — glide,  Shift+1..9 — cut"

msgid "[ ] — длительность перелёта"
msgstr "[ ] — glide length"

msgid "Z / X — медленнее / быстрее,  Пробел — стоп-кадр"
msgstr "Z / X — slower / faster,  Space — freeze frame"

msgid "B — широкий экран,  V — туман войны,  U — полоски здоровья"
msgstr "B — widescreen,  V — fog of war,  U — health bars"

msgid "N — следующее время суток,  R — дождь"
msgstr "N — next time of day,  R — rain"

msgid "ПКМ — приказ армии,  H — скрыть всё,  F10 / Esc — выход"
msgstr "RMB — order the army,  H — hide everything,  F10 / Esc — exit"

msgid "скорость ×%s · перелёт %s с · кадров: %d"
msgstr "speed ×%s · glide %s s · shots: %d"


msgstr "Health bars: hidden"

msgid "Полоски здоровья: видны"
msgstr "Health bars: shown"

msgid "Некого снимать"
msgstr "Nobody to film"

msgid "Кадр %d запомнен"
msgstr "Shot %d saved"

msgid "Кадр %d пуст: Ctrl+%d — запомнить"
msgstr "Shot %d is empty: Ctrl+%d saves it"

